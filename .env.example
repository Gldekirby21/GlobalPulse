# GlobalPulse — Environment Variables Template
# Copy this file to .env and insert your real credentials.

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Public Key (Safe for client-side queries protected by RLS)
SUPABASE_ANON_KEY=your_supabase_anon_key_here
